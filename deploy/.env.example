POSTGRES_SUPERUSER_PASSWORD=postgres
FORGEJO_DB_PASSWORD=forgejo
ORCHESTRATOR_DB_PASSWORD=orchestrator

# Phase 5: the two audit-trail roles deploy/migrations/001_roles.sql
# creates. ORCHESTRATOR_APP_DB_PASSWORD is reserved for the not-yet-wired
# orchestrator schema (see 002_orchestrator_schema.sql's comment).
ORCHESTRATOR_APP_DB_PASSWORD=orchestrator_app
ORCHESTRATOR_AUDIT_WRITER_DB_PASSWORD=orchestrator_audit_writer
# Host-side (for `make test-integration`) vs in-compose-network (for
# control-plane) — same split as FORGEJO_URL / FORGEJO_INTERNAL_URL.
AUDIT_DB_DSN=postgres://orchestrator_audit_writer:orchestrator_audit_writer@localhost:5432/orchestrator?sslmode=disable
AUDIT_DB_INTERNAL_DSN=postgres://orchestrator_audit_writer:orchestrator_audit_writer@postgres:5432/orchestrator?sslmode=disable
# Host-side superuser DSN, used only by the tamper-detection integration
# test (internal/control-plane/audit/postgres_integration_test.go) to simulate a write
# path with more privilege than orchestrator_audit_writer has.
AUDIT_DB_SUPERUSER_DSN=postgres://postgres:postgres@localhost:5432/orchestrator?sslmode=disable
# internal/control-plane/taskrunner's persisted task/round/step_runs state (design docs/
# designs/completed/full-pipeline-async-approval-design.md §4.2) — same split as
# AUDIT_DB_DSN/AUDIT_DB_INTERNAL_DSN, same database, different schema.
ORCHESTRATOR_DB_DSN=postgres://orchestrator_app:orchestrator_app@localhost:5432/orchestrator?sslmode=disable
ORCHESTRATOR_DB_INTERNAL_DSN=postgres://orchestrator_app:orchestrator_app@postgres:5432/orchestrator?sslmode=disable
FORGEJO_URL=http://localhost:3001
# In-compose-network address, for services/tests that need Forgejo reachable
# from inside a container rather than from the host (e.g. credentials
# injected into launcher-mock's fixtures, which run in-network).
FORGEJO_INTERNAL_URL=http://forgejo:3000
FORGEJO_ADMIN_USERNAME=forgejo-admin
FORGEJO_ADMIN_PASSWORD=changeme-local-only
# FORGEJO_ADMIN_TOKEN is appended here by deploy/bootstrap-admin.sh — do not hand-edit.

# Mock service endpoints (host-side, for local `go test -tags integration` runs).
SECRETS_MOCK_URL=http://localhost:8082
PDP_MOCK_URL=http://localhost:8081
LAUNCHER_MOCK_ADDR=localhost:9443
# Paths here are documentation only — `go test` runs with the package
# directory as its CWD, not the repo root, so `make test-integration`
# overrides these three with absolute paths. Set absolute paths yourself if
# running `go test -tags integration` directly instead of via `make`.
TLS_CA_CERT=./deploy/certs/ca.crt
TLS_CLIENT_CERT=./deploy/certs/client.crt
TLS_CLIENT_KEY=./deploy/certs/client.key

# Optional: override secrets-mock's static bot-token pool, e.g.
# SECRETS_MOCK_POOL_JSON={"review-bot":"...","ci-bot":"..."}
SECRETS_MOCK_POOL_JSON=

# design §4.4/§7: per-repo Forgejo webhook HMAC secrets, keyed "owner/name" —
# each entry must match the secret configured on that repo's own Forgejo
# webhook (gitclient.GitHostClient.CreateWebhook / a repo's hook settings).
# internal/control-plane/e2e's approval-flow scenario needs one entry for its own fixed
# scratch repo, e.g.
# SECRETS_MOCK_WEBHOOK_POOL_JSON='{"<FORGEJO_ADMIN_USERNAME>/e2e-approval-scratch":"some-shared-secret"}'
# Single-quote the whole value, unlike SECRETS_MOCK_POOL_JSON above: unlike
# that one, internal/control-plane/e2e's TestSmoke_ApprovalWebhookFlow reads this var back
# out of its own process environment (not just docker compose's env-file
# parser), and `make test-e2e`/`test-integration` populate it via
# `set -a; . deploy/.env`, i.e. real bash sourcing — which, unlike compose's
# own .env parser, strips *unquoted* embedded double quotes.
SECRETS_MOCK_WEBHOOK_POOL_JSON=
