POSTGRES_SUPERUSER_PASSWORD=postgres
FORGEJO_DB_PASSWORD=forgejo
ORCHESTRATOR_DB_PASSWORD=orchestrator
FORGEJO_URL=http://localhost:3001
# In-compose-network address, for services/tests that need Forgejo reachable
# from inside a container rather than from the host (e.g. credentials
# injected into launcher-mock's fixtures, which run in-network).
FORGEJO_INTERNAL_URL=http://forgejo:3000
FORGEJO_ADMIN_USERNAME=forgejo-admin
FORGEJO_ADMIN_PASSWORD=changeme-local-only
# FORGEJO_ADMIN_TOKEN is appended here by deploy/bootstrap-admin.sh — do not hand-edit.

# Mock service endpoints (host-side, for local `go test -tags integration` runs).
SECRETS_MOCK_URL=http://localhost:8082
PDP_MOCK_URL=http://localhost:8081
LAUNCHER_MOCK_ADDR=localhost:9443
# Paths here are documentation only — `go test` runs with the package
# directory as its CWD, not the repo root, so `make test-integration`
# overrides these three with absolute paths. Set absolute paths yourself if
# running `go test -tags integration` directly instead of via `make`.
TLS_CA_CERT=./deploy/certs/ca.crt
TLS_CLIENT_CERT=./deploy/certs/client.crt
TLS_CLIENT_KEY=./deploy/certs/client.key

# Optional: override secrets-mock's static bot-token pool, e.g.
# SECRETS_MOCK_POOL_JSON={"review-bot":"...","ci-bot":"..."}
SECRETS_MOCK_POOL_JSON=
